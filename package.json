{
  "name": "dsh-submodel",
  "version": "0.3.0",
  "description": "Two-way cross-model delegation for the official DSH subagent: routine execution on a cheap model, hard problems on a strong one. 官方 subagent 的双向跨模型派活策略：常规执行走便宜模型、难题升级强模型，token 花在刀刃上。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npm run test:node && npm run test:python",
    "test:node": "node tests/unit/flash-routing-fixture.mjs ./lib && node tests/unit/public-profile-smoke.mjs",
    "test:python": "python -m unittest discover -s tests/unit -v"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angel291592/dsh-submodel.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "delegation",
    "policy",
    "model-routing",
    "token-optimization",
    "cost-optimization",
    "routing",
    "agent-teams",
    "flash"
  ]
}
